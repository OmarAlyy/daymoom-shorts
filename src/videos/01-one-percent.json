 "captions": [
  {
   "from": 2.0,
   "to": 5.0,
   "text": "Every January you say: this time will be *different.*"
  },
  {
   "from": 5.3,
   "to": 8.0,
   "text": "Mm-hm. *Sure.*"
  },
  {
   "from": 8.4,
   "to": 11.0,
   "text": "Three weeks later? Back to *zero.*"
  },
  {
   "from": 13.0,
   "to": 16.0,
   "text": "Been there. *Literally.*"
  },
  {
   "from": 16.3,
   "to": 18.0,
   "text": "Okay. Here's the *secret.*"
  },
  {
   "from": 18.2,
   "to": 21.0,
   "text": "Forget the *big leap.*"
  },
  {
   "from": 21.2,
   "to": 24.0,
   "text": "One percent. A day. That's the *trick.*"
  },
  {
   "from": 24.3,
   "to": 26.6,
   "text": "One percent better every day,"
  },
  {
   "from": 26.6,
   "to": 29.4,
   "text": "and a year later, you're *37 times* better."
  },
  {
   "from": 32.3,
   "to": 35.0,
   "text": "The first weeks feel like *nothing.*"
  },
  {
   "from": 35.0,
   "to": 37.1,
   "text": "This is where most people *quit.*"
  },
  {
   "from": 37.2,
   "to": 40.0,
   "text": "Not us. Keep *showing up.*"
  },
  {
   "from": 40.3,
   "to": 43.0,
   "text": "So make it tiny. *Too small to skip.*"
  },
  {
   "from": 43.2,
   "to": 46.0,
   "text": "Missed a day? *Never miss twice.*"
  },
  {
   "from": 46.2,
   "to": 48.0,
   "text": "See you on the *climb.*"
  }
 ],
 "headlines": [
